{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sharedock",
  "version": "0.1.0",
  "identifier": "app.sharedock.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @app/web dev",
    "beforeBuildCommand": "pnpm --filter @app/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sharedock",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/pc-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://REPLACE-WITH-YOUR-ORIGIN/api/updates/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  },
  "mainBinaryName": "Sharedock"
}
