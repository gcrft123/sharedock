{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cells/**",
              "components/chrome/**",
              "components/controls/**",
              "components/icon/**",
              "components/overlay/**",
              "components/pricing/**",
              "components/telemetry/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|Space Grotesk|JetBrains Mono|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, Space Grotesk, JetBrains Mono, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|arrow|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, arrow, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:secondary|primary|ghost)$/]",
        "message": "<Button> variant must be one of 'secondary' | 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapabilityCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|children|statLabel|statValue|cross|key|ref|className|style|children)$/]",
        "message": "<CapabilityCell> doesn't accept that prop. Declared props: index, title, children, statLabel, statValue, cross."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|tone|title|eyebrow|confirmLabel|cancelLabel|dismissible|embedded|onConfirm|onCancel|children|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: open, tone, title, eyebrow, confirmLabel, cancelLabel, dismissible, embedded, onConfirm, onCancel, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:confirm|warning|danger)$/]",
        "message": "<ConfirmDialog> tone must be one of 'confirm' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crosshair'] > JSXAttribute > JSXIdentifier[name!=/^(?:pos|key|ref|className|style|children)$/]",
        "message": "<Crosshair> doesn't accept that prop. Declared props: pos."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crosshair'] > JSXAttribute[name.name='pos'] > Literal[value!=/^(?:tl|tr|bl|br)$/]",
        "message": "<Crosshair> pos must be one of 'tl' | 'tr' | 'bl' | 'br'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Equalizer'] > JSXAttribute > JSXIdentifier[name!=/^(?:bars|height|key|ref|className|style|children)$/]",
        "message": "<Equalizer> doesn't accept that prop. Declared props: bars, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudReadout'] > JSXAttribute > JSXIdentifier[name!=/^(?:k|v|u|key|ref|className|style|children)$/]",
        "message": "<HudReadout> doesn't accept that prop. Declared props: k, v, u."
      },
      {
        "selector": "JSXOpeningElement[name.name='HumanCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:chip|chipTone|title|children|foot|cross|key|ref|className|style|children)$/]",
        "message": "<HumanCell> doesn't accept that prop. Declared props: chip, chipTone, title, children, foot, cross."
      },
      {
        "selector": "JSXOpeningElement[name.name='HumanCell'] > JSXAttribute[name.name='chipTone'] > Literal[value!=/^(?:amber|peach|cream)$/]",
        "message": "<HumanCell> chipTone must be one of 'amber' | 'peach' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<PillChip> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:amber|peach|cream)$/]",
        "message": "<PillChip> tone must be one of 'amber' | 'peach' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|priceNote|features|featured|ctaLabel|ctaHref|onCta|key|ref|className|style|children)$/]",
        "message": "<PricingTier> doesn't accept that prop. Declared props: name, price, priceNote, features, featured, ctaLabel, ctaHref, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|note|className|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: id, title, note, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|sub|decimals|orange|cross|key|ref|className|style|children)$/]",
        "message": "<StatCell> doesn't accept that prop. Declared props: label, value, unit, sub, decimals, orange, cross."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|unit|sys|feed|lat|sticky|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: brand, unit, sys, feed, lat, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:t|text|key|ref|className|style|children)$/]",
        "message": "<TerminalLine> doesn't accept that prop. Declared props: t, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute[name.name='t'] > Literal[value!=/^(?:cmd|out|ok|warn)$/]",
        "message": "<TerminalLine> t must be one of 'cmd' | 'out' | 'ok' | 'warn'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
